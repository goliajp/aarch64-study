{
  "name": "aarch64-study",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "AArch64 SoC simulator in the browser — teach OS internals one architectural concept per version (Rust → WASM)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goliajp/aarch64-study.git"
  },
  "homepage": "https://labs.golia.jp/aarch64/",
  "bugs": "https://github.com/goliajp/aarch64-study/issues",
  "keywords": [
    "aarch64",
    "arm64",
    "simulator",
    "operating-system",
    "education",
    "rust",
    "wasm",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && prettier --write src/ && vite build",
    "deploy": "bun run build && rsync -avz --delete dist/ t01:/apps/labs/aarch64/",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint src/ && prettier --check src/",
    "fix": "eslint --fix src/ && prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:sim": "wasm-pack build crates/aarch64-sim --target web --out-dir pkg --release && rm -f crates/aarch64-sim/pkg/.gitignore",
    "test:sim": "cargo test -p aarch64-sim"
  },
  "dependencies": {
    "aarch64-sim": "file:./crates/aarch64-sim/pkg",
    "@goliapkg/gds": "^2.2.0",
    "jotai": "^2.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.2",
    "tailwindcss": "4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
